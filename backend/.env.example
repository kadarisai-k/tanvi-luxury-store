# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/tanvi_store

# Auth
ADMIN_JWT_SECRET=replace_with_a_long_random_string
# Customer sessions (email-OTP login, signed as a JWT)
CUSTOMER_JWT_SECRET=replace_with_a_different_long_random_string

# Seed admin (used only by seed script to create the first admin user)
ADMIN_EMAIL=admin@tanvistore.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Store Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email (Gmail SMTP App Password — see backend/src/services/mailer.js for setup steps)
# Leave blank to have OTPs printed to the server console instead of emailed (dev mode).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM_NAME="Tanvi Luxury Store"

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
